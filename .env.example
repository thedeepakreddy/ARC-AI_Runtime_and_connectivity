# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 32

POSTGRES_USER=arc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arc

# Internal key used only between ARC and LiteLLM (must start with "sk-").
LITELLM_MASTER_KEY=sk-change-me

LOG_LEVEL=info

# Behind HTTPS (required for secure session cookies). Set false only for local HTTP testing.
COOKIE_SECURE=true
# Set true when a reverse proxy (e.g. Caddy/Nginx) terminates TLS in front of ARC.
TRUST_PROXY=false

# Customer sign-up in the dashboard (/dashboard): "invite" needs a link from you or a customer's
# admin; "open" lets anyone create an organization. Customers only ever use their own keys.
SIGNUP_MODE=invite

# LiteLLM worker processes (see docs/adr/0008-operations.md for the measurement).
LITELLM_NUM_WORKERS=4

# Host port for the ARC API.
ARC_HTTP_PORT=8080

# Alerts by email (docker compose --profile monitoring). The SMTP password goes in
# secrets/smtp-password, never here. See docs/operations.md → Alerts by email.
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=you@gmail.com
ALERT_SMTP_USER=you@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_REQUIRE_TLS=true

# Backups (docker compose --profile ops run --rm ops scripts/ops/backup.sh).
BACKUP_RETENTION_DAYS=14
# Off-site copy with rclone, e.g. oci:arc-backups (config in secrets/rclone.conf).
BACKUP_RCLONE_REMOTE=
