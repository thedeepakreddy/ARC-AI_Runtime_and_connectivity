# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 32

POSTGRES_USER=arc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arc

# Internal key used only between ARC and LiteLLM (must start with "sk-").
LITELLM_MASTER_KEY=sk-change-me

LOG_LEVEL=info

# Behind HTTPS (required for secure session cookies). Set false only for local HTTP testing.
COOKIE_SECURE=true
# Set true when a reverse proxy (e.g. Caddy/Nginx) terminates TLS in front of ARC.
TRUST_PROXY=false

# HTTPS with the bundled Caddy (docker compose --profile https up -d): your domain (or free
# subdomain, e.g. arc.example.duckdns.org) pointing at this server, and an email for Let's
# Encrypt notices. With Caddy, set TRUST_PROXY=true above.
ARC_DOMAIN=
ACME_EMAIL=
# This ARC's public address, for links in emails and Google sign-in (usually https://ARC_DOMAIN).
# Password reset and email verification are on when PUBLIC_URL and the ALERT_* SMTP settings
# below are set (same account, same secrets/smtp-password).
PUBLIC_URL=

# Google sign-in (optional): an OAuth client of type "Web application" in Google Cloud Console,
# redirect URI https://<ARC_DOMAIN>/admin/v1/auth/google/callback. The client secret goes in
# secrets/google-client-secret.
GOOGLE_CLIENT_ID=

# Google AdSense in the customer dashboard's sidebar (optional; see docs/operations.md → Ads).
ADSENSE_CLIENT=
ADSENSE_SLOT=

# Customer sign-up in the dashboard (/dashboard): "invite" needs a link from you or a customer's
# admin; "open" lets anyone create an organization. Customers only ever use their own keys.
SIGNUP_MODE=invite

# LiteLLM worker processes (see docs/adr/0008-operations.md for the measurement).
LITELLM_NUM_WORKERS=4

# Host port for the ARC API.
ARC_HTTP_PORT=8080

# Alerts by email (docker compose --profile monitoring). The SMTP password goes in
# secrets/smtp-password, never here. See docs/operations.md → Alerts by email.
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=you@gmail.com
ALERT_SMTP_USER=you@gmail.com
ALERT_SMTP_HOST=smtp.gmail.com:587
ALERT_SMTP_REQUIRE_TLS=true

# Backups (docker compose --profile ops run --rm ops scripts/ops/backup.sh).
BACKUP_RETENTION_DAYS=14
# Off-site copy with rclone, e.g. gcs:arc-backups (config in secrets/rclone.conf).
BACKUP_RCLONE_REMOTE=
