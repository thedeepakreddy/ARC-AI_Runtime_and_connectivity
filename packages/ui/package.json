{
  "name": "@arc/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ARC's design system: tokens, components, the wordmark, the space art and the admin API client. Shared by the owner console and the customer dashboard. Source-only; each app's Vite build compiles it.",
  "exports": {
    ".": "./src/index.tsx",
    "./api": "./src/api.ts",
    "./format": "./src/format.ts",
    "./hooks": "./src/hooks.ts",
    "./fonts": "./src/fonts.ts",
    "./styles.css": "./src/styles.css",
    "./keys": "./src/keys.tsx",
    "./account": "./src/account.tsx",
    "./auth": "./src/auth.tsx",
    "./security": "./src/security.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vite": "^8.3.8"
  }
}
