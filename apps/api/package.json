{
  "name": "@arc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=arc-source src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli/migrate.js",
    "create-owner": "node dist/cli/create-owner.js",
    "vault:keygen": "node dist/cli/vault-keygen.js",
    "vault:rewrap": "node dist/cli/vault-rewrap.js"
  },
  "dependencies": {
    "@arc/shared": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
